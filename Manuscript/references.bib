@article{gronneberg_foldnes_2022,
	title = {covsim: {An} {R} {Package} for {Simulating} {Non}-{Normal} {Data} for {Structural} {Equation} {Models} {Using} {Copulas}},
	volume = {102},
	url = {https://www.jstatsoft.org/index.php/jss/article/view/v102i03},
	doi = {10.18637/jss.v102.i03},
	abstract = {\&lt;p\&gt;In factor analysis and structural equation modeling non-normal data simulation is traditionally performed by specifying univariate skewness and kurtosis together with the target covariance matrix. However, this leaves little control over the univariate distributions and the multivariate copula of the simulated vector. In this paper we explain how a more flexible simulation method called vine-to-anything (VITA) may be obtained from copula-based techniques, as implemented in a new R package, covsim. VITA is based on the concept of a regular vine, where bivariate copulas are coupled together into a full multivariate copula. We illustrate how to simulate continuous and ordinal data for covariance modeling, and how to use the new package discnorm to test for underlying normality in ordinal data. An introduction to copula and vine simulation is provided in the appendix.\&lt;/p\&gt;},
	number = {3},
	urldate = {2024-11-27},
	journal = {Journal of Statistical Software},
	author = {Grønneberg, Steffen and Foldnes, Njål and Marcoulides, Katerina M.},
	month = may,
	year = {2022},
	note = {Section: Articles},
	pages = {1 -- 45},
}

@article{kelava_brandt_2009,
	title = {Estimation of nonlinear latent structural equation models using the extended unconstrained approach.},
	volume = {16},
	issn = {1849-0905(Electronic),1330-6812(Print)},
	abstract = {In the past two decades, several approaches for the estimation of single interaction effects in latent structural equation models (SEM) have been published (for an overview: Marsh, Wen, \& Hau, 2006; Schumacker \& Marcoulides, 1998). Recent literature has begun to consider nonlinear models involving simultaneous interaction and quadratic effects (e.g. Klein \& Muthén, 2007; Lee, Song, \& Poon, 2004; MacCallum \& Mar, 1995). Marsh, Wen, and Hau (2004) developed an unconstrained product indicator approach for the estimation of single interaction effects with robust properties when distributional assumptions are violated. In this article, first, we give a brief overview on the approaches for the estimation of nonlinear SEM. Second, we describe the extended unconstrained approach for the simultaneous estimation of latent interaction and quadratic effects (Kelava, 2009; Moosbrugger, Schermelleh-Engel, Kelava, \& Klein, 2009). Third, we apply the extended unconstrained approach to data from work and stress research using the freely accessible sem package (Fox, 2006) in R (R Development Core Team, 2008) and compare it with LMS (Klein \& Moosbrugger, 2000) which is implemented in the commercial Mplus (Muthén \& Muthén, 2007) software. (PsycINFO Database Record (c) 2017 APA, all rights reserved)},
	number = {2},
	journal = {Review of Psychology},
	author = {Kelava, Augustin and Brandt, Holger},
	year = {2009},
	note = {Place: Croatia
Publisher: Naklada Slap},
	keywords = {Structural Equation Modeling, *Statistical Estimation, *Nonlinear Regression},
	pages = {123--131},
}

